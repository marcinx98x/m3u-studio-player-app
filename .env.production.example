# --- Opcja A: osobna subdomena playera + CORS na backendzie PHP ---
# Wymaga IPTV_CORS_ORIGINS z https://m3u-studio-player.marcincloud.org
VITE_XTREAM_SERVER=https://m3u-studio.marcincloud.org/api/xtream
VITE_BASE_PATH=/

